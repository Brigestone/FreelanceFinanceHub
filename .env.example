# =======================================================================
# FreelanceFinanceHub - Variables de entorno (PLANTILLA)
# Copia este archivo como .env y completa los valores.
# .env NUNCA debe subirse a GitHub (ya está en .gitignore).
# =======================================================================

# --- Servidor -----------------------------------------------------------
PORT=3000
NODE_ENV=development

# Orígenes permitidos para CORS y protección CSRF (separados por coma).
# Debe coincidir con la URL que escribes en el navegador.
APP_ORIGIN=http://localhost:3000

# --- MariaDB (XAMPP) ----------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=freelancefinancehub
# Base exclusiva para pruebas automatizadas (debe terminar en _test).
DB_NAME_TEST=freelancefinancehub_test

# --- Sesión / JWT -------------------------------------------------------
# NO escribas un valor a mano. Genera uno seguro con:
#   npm run secret:generate
JWT_SECRET=CAMBIAR_EJECUTANDO_npm_run_secret:generate
JWT_EXPIRES_IN=8h
COOKIE_NAME=ffh_session

# --- Límites de intentos (opcional) -------------------------------------
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_REGISTER_MAX=10

# --- SMTP / Correo (Fase 5) ---------------------------------------------
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@freelancefinancehub.local
